# --- Backend (Maven / Java) ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/**/*.class
backend/src/main/resources/firebase/*.json
!backend/src/main/resources/firebase/.gitkeep

# --- Frontend (React Native / Node) ---
mobile/node_modules/
mobile/npm-debug.log*
mobile/yarn-debug.log*
mobile/yarn-error.log*
mobile/.expo/
mobile/dist/
mobile/web-build/

# Android
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/release/
