# Copy to `.env` and fill in real values before running `docker compose up`.
# Consumed by docker-compose.yml — never commit the real `.env`.

# --- PostgreSQL ---
POSTGRES_DB=umurinzi
POSTGRES_USER=umurinzi
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Firebase Admin SDK (place the downloaded service-account JSON at
# backend/src/main/resources/firebase/service-account.json — gitignored)
FIREBASE_CREDENTIALS_PATH=classpath:firebase/service-account.json

# SMS provider — set SMS_PROVIDER to africas_talking or twilio (§1.3/§8 of the SDD)
SMS_PROVIDER=africas_talking
AFRICAS_TALKING_API_KEY=change-me
AFRICAS_TALKING_USERNAME=change-me
AFRICAS_TALKING_SENDER_ID=UMURINZI
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=change-me

# --- pgAdmin (optional dev convenience, docker-compose --profile tools) ---
PGADMIN_DEFAULT_EMAIL=admin@umurinzi.local
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
